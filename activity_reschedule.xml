<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#DFF3F2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Card -->
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp">

        <!-- Title -->
        <TextView
            android:text="Reschedule Medicine ⏰"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D6CCF"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Subtitle -->
        <TextView
            android:text="Choose when you want to take it"
            android:textSize="14sp"
            android:textColor="#388E3C"
            android:layout_marginBottom="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Quick Options -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btn10"
                android:text="10 min"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:backgroundTint="#5FC4B8"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btn30"
                android:text="30 min"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:backgroundTint="#2D6CCF"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btn60"
                android:text="1 hr"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Custom Input -->
        <EditText
            android:id="@+id/minutesInput"
            android:hint="Or enter custom minutes"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

        <!-- Actions -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/yesBtn"
                android:text="Reschedule"
                android:textAllCaps="false"
                android:layout_weight="1"
                android:backgroundTint="#5FC4B8"
                android:textColor="#FFFFFF"
                android:layout_width="0dp"
                android:layout_height="50dp"/>

            <Button
                android:id="@+id/noBtn"
                android:text="Skip"
                android:textAllCaps="false"
                android:layout_weight="1"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                android:layout_marginStart="10dp"
                android:layout_width="0dp"
                android:layout_height="50dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>